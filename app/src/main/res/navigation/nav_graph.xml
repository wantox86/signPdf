<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.wantox86.signpdf.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_pdfEditorFragment"
            app:destination="@id/pdfEditorFragment" />
        <action
            android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.wantox86.signpdf.ui.auth.LoginFragment"
        android:label="@string/login_title"
        tools:layout="@layout/fragment_login" />

    <fragment
        android:id="@+id/pdfEditorFragment"
        android:name="com.wantox86.signpdf.ui.editor.PdfEditorFragment"
        android:label="PDF Editor"
        tools:layout="@layout/fragment_pdf_editor">
        <argument
            android:name="pdfUri"
            app:argType="string" />
        <action
            android:id="@+id/action_pdfEditorFragment_to_pdfPreviewFragment"
            app:destination="@id/pdfPreviewFragment" />
    </fragment>

    <fragment
        android:id="@+id/pdfPreviewFragment"
        android:name="com.wantox86.signpdf.ui.preview.PdfPreviewFragment"
        android:label="@string/preview_title"
        tools:layout="@layout/fragment_pdf_preview">
        <argument
            android:name="filePath"
            app:argType="string" />
        <argument
            android:name="firstSignedPage"
            app:argType="integer"
            android:defaultValue="0" />
    </fragment>

    <fragment
        android:id="@+id/signatureCanvasFragment"
        android:name="com.wantox86.signpdf.ui.signature.SignatureCanvasFragment"
        android:label="Signature Canvas"
        tools:layout="@layout/fragment_signature_canvas">
        <argument
            android:name="type"
            app:argType="string" />
    </fragment>

</navigation>
