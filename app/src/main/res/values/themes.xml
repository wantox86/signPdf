<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ink & Paper Design System (Light Mode in Phase 1; DayNight + Obsidian Dark added in Phase 6).
         Status bar and navigation bar are transparent for Android Edge-to-Edge. -->
    <style name="Theme.SignPDF" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/sp_primary</item>
        <item name="colorOnPrimary">@color/sp_on_primary</item>
        <item name="colorPrimaryContainer">@color/sp_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/sp_on_primary_container</item>
        <item name="colorSecondary">@color/sp_accent</item>
        <item name="colorOnSecondary">@color/sp_on_accent</item>
        <item name="colorSecondaryContainer">@color/sp_accent_container</item>
        <item name="colorOnSecondaryContainer">@color/sp_accent</item>
        <item name="colorSurface">@color/sp_surface</item>
        <item name="colorOnSurface">@color/sp_on_surface</item>
        <item name="colorSurfaceVariant">@color/sp_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/sp_on_surface_variant</item>
        <item name="colorOutline">@color/sp_outline</item>
        <item name="colorOutlineVariant">@color/sp_outline_variant</item>
        <item name="android:colorBackground">@color/sp_background</item>
        <item name="android:windowBackground">@color/sp_background</item>

        <!-- Edge-to-Edge transparent system bars (light bar icons configured in MainActivity) -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="materialButtonStyle">@style/Widget.SignPDF.Button</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.SignPDF.Medium</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.SignPDF.BottomSheetDialog</item>
    </style>

    <!-- Shape Appearances -->
    <style name="ShapeAppearance.SignPDF.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/sp_corner_radius_medium</item>
    </style>

    <style name="ShapeAppearance.SignPDF.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/sp_corner_radius_sheet</item>
        <item name="cornerSizeTopRight">@dimen/sp_corner_radius_sheet</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Bottom Sheet Theme Overlay (24dp top corners) -->
    <style name="ThemeOverlay.SignPDF.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.SignPDF.BottomSheet</item>
    </style>

    <style name="Widget.SignPDF.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/sp_surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.SignPDF.BottomSheet</item>
    </style>

    <!-- Typography Scale (Ink & Paper) -->
    <style name="TextAppearance.SignPDF.AppTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/sp_text_primary</item>
    </style>

    <style name="TextAppearance.SignPDF.CardHeading" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/sp_text_primary</item>
    </style>

    <style name="TextAppearance.SignPDF.RowTitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/sp_text_primary</item>
    </style>

    <style name="TextAppearance.SignPDF.Body" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/sp_text_secondary</item>
    </style>

    <style name="TextAppearance.SignPDF.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/sp_text_secondary</item>
    </style>

    <style name="TextAppearance.SignPDF.MonoBadge" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/sp_text_secondary</item>
    </style>

    <!-- Buttons (Sentence case, 12dp radius, 48dp min touch target) -->
    <style name="Widget.SignPDF.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/sp_touch_target_min</item>
        <item name="backgroundTint">@color/sp_primary</item>
        <item name="android:textColor">@color/sp_on_primary</item>
        <item name="cornerRadius">@dimen/sp_corner_radius_small</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.SignPDF.Button.Accent" parent="Widget.SignPDF.Button">
        <item name="backgroundTint">@color/sp_accent</item>
        <item name="android:textColor">@color/sp_on_accent</item>
    </style>

    <style name="Widget.SignPDF.Button.Pill" parent="Widget.SignPDF.Button">
        <item name="cornerRadius">@dimen/sp_corner_radius_pill</item>
    </style>

    <style name="Widget.SignPDF.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/sp_touch_target_min</item>
        <item name="android:textColor">@color/sp_text_primary</item>
        <item name="strokeColor">@color/sp_outline</item>
        <item name="strokeWidth">@dimen/sp_stroke_hairline</item>
        <item name="cornerRadius">@dimen/sp_corner_radius_small</item>
    </style>

    <style name="Widget.SignPDF.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/sp_accent</item>
    </style>

    <!-- Cards (16dp radius, crisp 1dp hairline border, flat elevation) -->
    <style name="Widget.SignPDF.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/sp_surface</item>
        <item name="cardCornerRadius">@dimen/sp_corner_radius_medium</item>
        <item name="cardElevation">@dimen/sp_elevation_none</item>
        <item name="strokeColor">@color/sp_outline</item>
        <item name="strokeWidth">@dimen/sp_stroke_hairline</item>
    </style>
</resources>
