<?xml version="1.0" encoding="utf-8"?>
<!-- Modern Auto Backup + device-to-device transfer config (API 31+). Same reasoning as
     backup_rules.xml: keep the session token out of both cloud backup and transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
