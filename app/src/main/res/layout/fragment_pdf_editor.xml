<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sp_background"
    tools:context=".ui.editor.PdfEditorFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_editor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sp_surface"
        android:minHeight="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/sp_text_primary"
        app:navigationContentDescription="@string/back"
        app:menu="@menu/menu_pdf_editor"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_document_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/sp_text_primary"
            tools:text="document.pdf" />
    </com.google.android.material.appbar.MaterialToolbar>

    <FrameLayout
        android:id="@+id/editor_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar_editor"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ZoomableContainer bungkus RecyclerView buat pinch-to-zoom + pan satu level ke semua
             halaman. Murni transform visual di RecyclerView-nya sendiri: nggak nyentuh
             SignatureOverlayView atau koordinat overlay yang tersimpan sama sekali. -->
        <com.wantox86.signpdf.ui.editor.ZoomableContainer
            android:id="@+id/zoomable_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_pdf_pages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="8dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_pdf_page" />
        </com.wantox86.signpdf.ui.editor.ZoomableContainer>
    </FrameLayout>

    <ProgressBar
        android:id="@+id/progress_loading_pages"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/editor_container"
        app:layout_constraintEnd_toEndOf="@id/editor_container"
        android:layout_margin="16dp"
        tools:visibility="visible" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_paraf"
        style="@style/Widget.Material3.FloatingActionButton.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/sp_spacing_sm"
        android:contentDescription="@string/add_paraf"
        android:src="@drawable/ic_initial_mark"
        android:visibility="gone"
        app:tint="?attr/colorOnSecondaryContainer"
        app:layout_constraintBottom_toTopOf="@id/fab_add_ttd"
        app:layout_constraintEnd_toEndOf="@id/fab_add_signature"
        tools:visibility="visible" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_ttd"
        style="@style/Widget.Material3.FloatingActionButton.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/sp_spacing_sm"
        android:contentDescription="@string/add_ttd"
        android:src="@drawable/ic_sign_mark"
        android:visibility="gone"
        app:tint="?attr/colorOnSecondaryContainer"
        app:layout_constraintBottom_toTopOf="@id/fab_add_signature"
        app:layout_constraintEnd_toEndOf="@id/fab_add_signature"
        tools:visibility="visible" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_signature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/sp_spacing_lg"
        android:layout_marginBottom="@dimen/sp_spacing_md"
        android:contentDescription="@string/add_signature"
        android:src="@drawable/ic_edit_signature"
        app:tint="@color/sp_on_primary"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sp_surface"
        android:elevation="@dimen/sp_elevation_medium"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/sp_spacing_lg"
        android:paddingVertical="@dimen/sp_spacing_md"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_save_and_share"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="@string/save_and_share"
            android:textAppearance="?attr/textAppearanceTitleMedium" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
