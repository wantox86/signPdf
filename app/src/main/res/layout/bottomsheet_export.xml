<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="28dp">

    <!-- 40x4dp Drag Handle -->
    <View
        android:layout_width="@dimen/sp_drag_handle_width"
        android:layout_height="@dimen/sp_drag_handle_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Header: Emerald file-check badge + Title/Subtitle + Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_icon_badge_success">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_file_check"
                app:tint="@color/sp_success_text" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_export_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/export_sheet_title"
                android:textAppearance="@style/TextAppearance.SignPDF.CardHeading"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_export_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.SignPDF.Body"
                tools:text="RFC Rollout Cash Management v4_signed.pdf · 248 KB" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_export_sheet"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="@color/sp_text_secondary" />
    </LinearLayout>

    <!-- 2-Column Action Grid: Preview PDF (Secondary) & Share PDF (Primary Blue) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Preview PDF (Secondary Outlined Card) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_preview_pdf"
            style="@style/Widget.SignPDF.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_icon_badge_accent">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_preview_eye"
                        app:tint="@color/sp_accent" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/export_action_preview"
                    android:textAppearance="@style/TextAppearance.SignPDF.RowTitle"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/export_action_preview_subtitle"
                    android:textAppearance="@style/TextAppearance.SignPDF.Body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Share PDF (Primary Accent Blue Card) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_share_pdf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/sp_accent"
            app:cardCornerRadius="@dimen/sp_corner_radius_medium"
            app:cardElevation="@dimen/sp_elevation_none"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_icon_badge_on_accent">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_export"
                        app:tint="@color/sp_on_accent" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/export_action_share"
                    android:textAppearance="@style/TextAppearance.SignPDF.RowTitle"
                    android:textColor="@color/sp_on_accent"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.85"
                    android:text="@string/export_action_share_subtitle"
                    android:textAppearance="@style/TextAppearance.SignPDF.Body"
                    android:textColor="@color/sp_on_accent" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</LinearLayout>
