<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sp_background">

    <!-- Top Toolbar with Back + Title + 3 Ink Color Dots -->
    <LinearLayout
        android:id="@+id/toolbar_signature_canvas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/sp_surface"
        android:gravity="center_vertical"
        android:minHeight="?attr/actionBarSize"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_canvas_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/sp_text_primary" />

        <TextView
            android:id="@+id/tv_canvas_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/draw_signature_title"
            android:textAppearance="@style/TextAppearance.SignPDF.CardHeading"
            android:textSize="16sp" />

        <View
            android:id="@+id/dot_canvas_black"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_ink_dot_black"
            android:clickable="true"
            android:contentDescription="@string/ink_black"
            android:focusable="true" />

        <View
            android:id="@+id/dot_canvas_blue"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_ink_dot_blue"
            android:clickable="true"
            android:contentDescription="@string/ink_blue"
            android:focusable="true" />

        <View
            android:id="@+id/dot_canvas_crimson"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_ink_dot_crimson"
            android:clickable="true"
            android:contentDescription="@string/ink_crimson"
            android:focusable="true" />
    </LinearLayout>

    <View
        android:id="@+id/divider_toolbar_canvas"
        android:layout_width="0dp"
        android:layout_height="@dimen/sp_stroke_hairline"
        android:background="@color/sp_outline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_signature_canvas" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_signature_pad"
        style="@style/Widget.SignPDF.Card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/sp_spacing_md"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintBottom_toTopOf="@id/action_row"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider_toolbar_canvas">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.github.gcacace.signaturepad.views.SignaturePad
                android:id="@+id/signature_pad"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/white"
                android:saveEnabled="false" />

            <TextView
                android:id="@+id/tv_canvas_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/draw_placeholder"
                android:textColor="@color/sp_outline_variant"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="bottom"
                android:layout_marginHorizontal="28dp"
                android:layout_marginBottom="48dp"
                android:background="@drawable/bg_signature_baseline"
                android:layerType="software" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/action_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/sp_surface"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/sp_spacing_md"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clear"
            style="@style/Widget.SignPDF.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/clear"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm"
            style="@style/Widget.SignPDF.Button.Accent"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1.5"
            android:enabled="false"
            android:text="@string/save_signature"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
